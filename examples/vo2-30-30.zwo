<workout_file>
    <author>trainer-cli</author>
    <name>VO2 30/30 x 2 sets</name>
    <description>Two sets of 10x 30s @ 120% / 30s @ 50%</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5"/>
        <SteadyState Duration="300" Power="0.55"/>
        <IntervalsT Repeat="10" OnDuration="30" OffDuration="30" OnPower="1.2" OffPower="0.5"/>
        <Cooldown Duration="480" PowerLow="0.65" PowerHigh="0.4"/>
    </workout>
</workout_file>
